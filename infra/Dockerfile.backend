# syntax=docker/dockerfile:1.7
# Backend image for ScholarHUB.
#
# Multi-stage: builder uses uv to materialize the project venv from
# ``pyproject.toml`` + ``uv.lock``; runtime copies just the venv + app
# source. The runtime image carries no build tooling, runs as non-root,
# and is small enough for fast pulls.
#
# Build context is the repo root (see ``infra/docker-compose.yml``).

# --- builder ----------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

# Tell uv to materialize the venv at a fixed path we can COPY in the next
# stage. UV_COMPILE_BYTECODE avoids runtime .pyc churn.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_FROZEN=1

WORKDIR /app

# Copy dependency manifests first so this layer is cached across source-only
# changes. ``--no-install-project`` skips installing the project itself;
# we do that after copying source so editable installs resolve.
COPY apps/backend/pyproject.toml apps/backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy the rest of the backend source and install the project itself.
COPY apps/backend/ ./
RUN uv sync --frozen --no-dev

# --- runtime ----------------------------------------------------------------
FROM python:3.14-slim AS runtime

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Non-root user; uid 1000 matches the host user on most dev machines so
# mounted volumes aren't chowned to root.
RUN useradd --create-home --uid 1000 --shell /bin/sh app

COPY --from=builder /opt/venv /opt/venv

USER app
WORKDIR /app
COPY --chown=app:app apps/backend/ ./

EXPOSE 8000

# Single-process: run migrations then serve. For real prod, run migrations
# as a one-shot job (``docker compose run --rm backend alembic upgrade head``)
# and let this CMD be just ``uvicorn ...``.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]

# syntax=docker/dockerfile:1.7
# Frontend image for ScholarHUB.
#
# Multi-stage: Node.js builder compiles the Vite/React app, then a minimal
# nginx runtime serves the static output. Build context is the repo root
# (see ``infra/docker-compose.prod.yml``).

# --- builder ----------------------------------------------------------------
FROM node:26-alpine AS builder

WORKDIR /app

# Copy dependency manifests first so this layer is cached across source-only
# changes. ``npm ci`` respects the lockfile and is faster than ``npm install``.
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

# Copy the rest of the frontend source and build for production.
COPY apps/frontend/ ./
RUN npm run build

# --- runtime ----------------------------------------------------------------
FROM nginx:alpine AS runtime

# Copy static assets from the builder stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# Use our nginx config with SPA fallback and caching headers.
COPY infra/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx:alpine runs as the ``nginx`` user by default — no root.
CMD ["nginx", "-g", "daemon off;"]